# No secrets are required for P1 — all data is synthetic and generated
# locally by app/data_gen.py. These variables configure deployment behavior.

# Port the API listens on. Most PaaS platforms (Render, Railway, Heroku,
# Cloud Run) inject $PORT automatically at runtime — the documented startup
# command reads it with a fallback to 8000 for local use.
PORT=8000

# Comma-separated list of exact frontend origins allowed to call this API
# via CORS. Do NOT use "*" in production if allow_credentials is enabled
# (browsers reject that combination, and it's not a safe default anyway).
# Example for a deployed frontend:
#   ALLOWED_ORIGINS=https://medcare-p1.vercel.app
# Multiple origins:
#   ALLOWED_ORIGINS=https://medcare-p1.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

MEDCARE_ENV=local
MEDCARE_DB_PATH=./medcare.db

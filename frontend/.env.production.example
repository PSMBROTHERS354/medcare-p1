# Copy this to .env.production (or set the equivalent env var in your hosting
# platform's dashboard) before running `npm run build` for a real deployment.
#
# IMPORTANT: Vite bakes VITE_* variables into the built JS bundle at BUILD
# TIME, not at container/server runtime. Changing this value after the
# frontend has been built requires rebuilding (and, for Docker, requires
# passing it as a --build-arg — see frontend/Dockerfile and DEPLOYMENT.md).
VITE_API_BASE_URL=https://<your-deployed-backend-url>
